#!/bin/bash
# prerm — Video HEVC Converter
set -e

case "$1" in
    remove|upgrade|deconfigure)
        if [ -d /run/systemd/system ]; then
            if systemctl is-active --quiet video-hevc-converter.service 2>/dev/null; then
                systemctl stop video-hevc-converter.service || true
            fi
            if [ "$1" = "remove" ]; then
                systemctl disable video-hevc-converter.service >/dev/null 2>&1 || true
            fi
        fi
        ;;
esac

#DEBHELPER#
exit 0
