# =============================================================================
# Video Conversion config — Ugreen DXP4800 Plus (Intel 8505 / Alder Lake-N)
# =============================================================================

# Directories inside the container to scan (map real paths in docker-compose.yml)
scan_paths:
  - /media/volume2/Data/Cinema/Movies
  - /media/volume2/Data/Cinema/TVShows

# File extensions considered "video". Anything else is ignored outright.
video_extensions:
  - .mp4
  - .mkv
  - .mov
  - .avi
  - .wmv
  - .flv
  - .m4v
  - .ts
  - .mts
  - .m2ts
  - .webm
  - .mpg
  - .mpeg
  - .vob
  - .3gp

# Codecs that are already efficient — skip entirely.
skip_codecs:
  - hevc          # H.265 / x265
  - h265
  - av1           # even more efficient than HEVC; leave alone
  - vp9

# Raw / log / intermediate / lossless formats — NEVER re-encode these.
# ffprobe codec_name values.
raw_codecs:
  - prores
  - prores_ks
  - dnxhd
  - dnxhr
  - cfhd          # GoPro CineForm
  - v210
  - v410
  - r210
  - r10k
  - huffyuv
  - ffv1
  - utvideo
  - rawvideo
  - mjpeg         # often used as intermediate
  - magicyuv
  - lagarith

# Extensions that indicate camera raw containers — skip regardless of codec.
raw_extensions:
  - .braw         # Blackmagic RAW
  - .r3d          # RED
  - .ari          # ARRI
  - .arriraw
  - .dng          # CinemaDNG
  - .crm          # Canon RAW
  - .mxf          # broadcast, often ProRes/DNxHD carrier — skip to be safe

# Filename markers that suggest raw/log source — skip on match (case-insensitive).
raw_filename_markers:
  - "_log"
  - ".log."
  - "slog"
  - "vlog"
  - "flog"
  - "hlg-raw"
  - "prores"
  - "dnxhr"
  - "master"
  - "intermediate"

# Minimum file size to bother converting (bytes). Skip tiny clips.
min_size_bytes: 20971520   # 20 MiB

# ---------------------------------------------------------------------------
# Encoder settings — Intel QSV hardware encode on the 8505 iGPU
# ---------------------------------------------------------------------------
encoder:
  # ICQ (Intelligent Constant Quality) — quality-based, closest to CRF.
  # Lower = higher quality / larger file. Sensible range: 15 (near-lossless)
  # to 30 (small). 18 is a good archival default for HEVC QSV; drop to 15 for
  # cherished grainy films.
  global_quality: 18

  # Slower preset = better compression at the same quality. "veryslow" is the
  # highest reasonable setting; QSV runs it well.
  preset: veryslow

  # Lookahead improves quality on scene changes. Depth in frames (max 100).
  # 60 is a safer default on Xe-LP iGPUs; 80+ can exhaust the driver's
  # surface-buffer pool on 4K sources and produce truncated output.
  look_ahead: true
  look_ahead_depth: 60

  # HW post-processing filters on the QSV path. 0 = off, 1..5 = intensity.
  # Sharpen restores micro-contrast lost to encoder smoothing; denoise
  # cleans noisy sources at the cost of erasing film grain.
  sharpen: 2
  denoise: 1

  # Regenerate output timestamps at a constant frame rate. Workaround for
  # QSV pipeline bugs where a long source produces a container whose header
  # says the correct duration but only the first N minutes are playable.
  # Set to false to preserve source PTS verbatim (needed for true VFR sources).
  fixed_frame_rate: true

  # Emit 10-bit HEVC (main10) for every source when true. Preserves 10-bit
  # sources and avoids encoder-introduced banding on 8-bit sources at the
  # cost of ~5–15% larger files and requires a decoder that supports main10.
  allow_10bit: true

  # Cap output bitrate as a sanity ceiling (0 = disabled).
  max_bitrate_kbps: 0

  # Copy color primaries / transfer / matrix / range tags from the source
  # to the output. Prevents playback tools from guessing (e.g. madVR).
  preserve_color_metadata: true

# ---------------------------------------------------------------------------
# Output container rules
# ---------------------------------------------------------------------------
output:
  # Keep original extension when the container supports HEVC (mp4/mkv/mov/ts).
  # For legacy containers (avi/wmv/flv/vob/mpg) remux into this container:
  fallback_container: .mkv

  # Copy all audio, subtitle, and attachment streams unchanged.
  copy_audio: true
  copy_subs: true

# ---------------------------------------------------------------------------
# Validation — how thoroughly to verify the transcoded file before replacing
# ---------------------------------------------------------------------------
validation:
  # Duration must be within this many seconds of the source.
  duration_tolerance_seconds: 1.5
  # Full decode pass (ffmpeg -f null) — slower but catches every corrupt frame.
  full_decode: true
  # Require at least one video stream & matching audio stream count.
  check_stream_counts: true

# ---------------------------------------------------------------------------
# Metadata provider (Rename tab title/year suggestions)
# ---------------------------------------------------------------------------
# Best set via the Setup tab in the web UI — the token is masked there and
# never sent to the browser after saving. This file can also be edited by
# hand. Empty string here falls back to the TMDB_API_TOKEN env var (see
# docker-compose.yml / .env).
metadata:
  tmdb_api_token: ""
  tmdb_language: "en-US"

# ---------------------------------------------------------------------------
# Runtime behaviour
# ---------------------------------------------------------------------------
runtime:
  # Delete the original file after successful validation + replace.
  # If false, keeps original as "<name>.orig<ext>" for you to review.
  delete_original: true
  # Where to stage the in-progress file. Fast local scratch is ideal.
  work_dir: /tmp/convert
  # Log file inside the /logs mount.
  log_file: /logs/converter.log
  # SQLite state DB — tracks processed files so we don't rescan them.
  state_db: /state/converter.db
  # Dry run: analyse & report only, no encoding.
  dry_run: false
  # Kill ffmpeg if it produces no progress line for this long (seconds).
  # 0 disables the watchdog. 300 = 5 min is generous for very slow storage.
  stall_timeout_seconds: 300
  # Wait this long and re-stat a file to make sure it isn't currently
  # being written (in-progress download, capture, etc.). Set 0 to disable.
  stability_check_seconds: 2.0
  # Time of day (HH:MM, 24-hour, container's local timezone — see the TZ env
  # variable in docker-compose.yml) for the automatic sweep. Each sweep
  # discovers new files AND converts them. Empty string disables scheduling
  # (use the web UI's "Scan now" / "Convert queued files" buttons for manual
  # runs). A sweep always runs at container startup regardless of this value.
  sweep_at_time: "03:00"
